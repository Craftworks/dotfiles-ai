# OS and editor local state
.DS_Store
Thumbs.db

# Secrets: never commit credentials or tokens
.env
.env.*
*.key
*.pem
*secret*
*credentials*

# Local-only overrides and scratch
*.local
tmp/

# Python bytecode cache
__pycache__/

# Rules
.cursor/rules/*
!.cursor/rules/.gitkeep
.claude/rules/*
!.claude/rules/.gitkeep