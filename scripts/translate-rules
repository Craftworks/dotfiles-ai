#!/usr/bin/env python3
"""Generate the English edition rules.en from rules.ja."""

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

from rule_source import MISSING_RULES_JA, load_rule
from translator import (
    NEXT_ACTION,
    TranslatorFailed,
    call_translator,
    check_output,
    kept_pairs,
    reset_translation,
    splice,
    write_atomically,
)


def git(root: Path, *args: str) -> str:
    completed = subprocess.run(
        ["git", "-C", str(root), *args], capture_output=True, check=True
    )
    return completed.stdout.decode("utf-8").replace("\r\n", "\n")


def rule_lines(description: str, body_text: str) -> list[str]:
    """The rule as the lines the line contract and the splice work on: the
    description, then the body lines (LF, no trailing newline)."""
    body = body_text.replace("\r\n", "\n")
    return [description] + body.rstrip("\n").split("\n")


def base_pair(root: Path, name: str) -> tuple[str, list[str], list[str]] | str:
    """The commit that last changed rules.en/<name>/body.md, with the Japanese
    and English lines of the rule at that commit, or the error line.

    Both sides come from the same commit, not the working tree, so line i of
    the English is the translation of line i of the Japanese.
    """
    commit = git(root, "log", "-1", "--format=%H", "--",
                 f"rules.en/{name}/body.md").strip()

    def show(rel: str) -> str | None:
        try:
            return git(root, "show", f"{commit}:{rel}")
        except subprocess.CalledProcessError:
            return None

    ja_meta, ja_body = show(f"rules.ja/{name}/meta.json"), show(f"rules.ja/{name}/body.md")
    if ja_meta is None or ja_body is None:
        return (f"{name}: rules.ja/{name} is not in commit {commit[:12]}. "
                f"delete rules.en/{name} to translate it in full, then rerun")
    en_meta, en_body = show(f"rules.en/{name}/meta.json"), show(f"rules.en/{name}/body.md")
    if en_meta is None or en_body is None:
        return (f"{name}: rules.en/{name} is incomplete in commit {commit[:12]}. "
                f"delete rules.en/{name} to translate it in full, then rerun")
    try:
        ja = rule_lines(json.loads(ja_meta)["description"], ja_body)
        en = rule_lines(json.loads(en_meta)["description"], en_body)
    except (json.JSONDecodeError, KeyError, TypeError):
        return (f"{name}: meta.json in commit {commit[:12]} is not a valid rule. "
                f"delete rules.en/{name} to translate it in full, then rerun")
    if len(ja) != len(en):
        return (f"{name}: rules.ja/{name}/body.md has {len(ja) - 1} lines and "
                f"rules.en/{name}/body.md has {len(en) - 1} at commit {commit[:12]}. "
                f"delete rules.en/{name} to translate it in full, then rerun")
    return commit, ja, en


def git_error(root: Path) -> str | None:
    """The error line when git cannot read history under root, else None."""
    try:
        subprocess.run(["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"],
                       capture_output=True, check=True)
    except FileNotFoundError:
        return "rules.en: git was not found. install git, then rerun"
    except subprocess.CalledProcessError:
        return (f"rules.en: {root} is not a git repository. "
                "run translate-rules in a git clone of this repository")
    return None


def main(argv: list[str] | None = None) -> int:
    reset_translation()
    parser = argparse.ArgumentParser(
        description="Generate the English edition rules.en from rules.ja.",
    )
    parser.add_argument("--translator", default="claude",
                        help="translator command (default: claude)")
    parser.add_argument("--timeout", type=float, default=120,
                        help="seconds one translator call may take (default: 120)")
    parser.add_argument("names", nargs="*", metavar="name",
                        help="rules to consider (default: every rule)")
    args = parser.parse_args(argv)
    root = Path(__file__).resolve().parent.parent
    translator = shutil.which(args.translator) or args.translator
    rules_dir = root / "rules.ja"

    # Phase 1: decide every rule before any translator call, so an error in
    # one rule costs no calls and writes nothing.
    if not rules_dir.is_dir():
        print(MISSING_RULES_JA, file=sys.stderr)
        return 1
    available = sorted(p.name for p in rules_dir.iterdir() if p.is_dir())
    errors = [
        f"{name}: no such rule in rules.ja. pass the name of a directory under rules.ja"
        for name in args.names if name not in available
    ]
    selected = [name for name in available if not args.names or name in args.names]

    # History is read only for rules that already have English.
    if any((root / "rules.en" / name).is_dir() for name in selected):
        problem = git_error(root)
        if problem:
            print(problem, file=sys.stderr)
            return 1

    # (name, cursor, current Japanese lines, base pair or None, unchanged,
    #  whether rules.en/<name>/meta.json holds a different cursor)
    decided: list[tuple[str, dict, list[str], tuple[list[str], list[str]] | None,
                        bool, bool]] = []
    for name in selected:
        rule = load_rule(rules_dir / name)
        if isinstance(rule, str):
            errors.append(rule)
            continue
        ja_lines = rule_lines(rule.description, rule.body.decode("utf-8"))
        cursor = rule.cursor
        if not (root / "rules.en" / name).is_dir():
            decided.append((name, cursor, ja_lines, None, False, False))
            continue
        if git(root, "status", "--porcelain", "--", f"rules.en/{name}").strip():
            errors.append(
                f"{name}: rules.en/{name} has uncommitted changes. "
                f"commit or discard rules.en/{name}, then rerun"
            )
            continue
        pair = base_pair(root, name)
        if isinstance(pair, str):
            errors.append(pair)
            continue
        _commit, prev_ja, prev_en = pair
        # rules.en/<name> is clean here, so the working tree is the base.
        en_meta_text = (root / "rules.en" / name / "meta.json").read_text(encoding="utf-8")
        cursor_stale = json.loads(en_meta_text).get("cursor") != cursor
        decided.append((name, cursor, ja_lines, (prev_ja, prev_en),
                        prev_ja == ja_lines, cursor_stale))
    if errors:
        for message in errors:
            print(message, file=sys.stderr)
        return 1

    # Phase 2: translate the targets in memory; write only when all succeed.
    planned: list[tuple[Path, str]] = []
    for name, cursor, ja_lines, base, unchanged, cursor_stale in decided:
        out_dir = root / "rules.en" / name
        if unchanged and cursor_stale:
            # The cursor namespace is copied, never translated: no call.
            print(f"copying cursor of {name}", flush=True)
            en_meta = {"description": base[1][0], "cursor": cursor}
            planned.append((
                out_dir / "meta.json",
                json.dumps(en_meta, ensure_ascii=False, indent=2) + "\n",
            ))
            continue
        if unchanged:
            print(f"unchanged {name}", flush=True)
            continue
        print(f"translating {name}", flush=True)
        try:
            reference = kept_pairs(base[0], base[1], ja_lines) if base else []
            output = call_translator(translator, ja_lines, reference, args.timeout)
            en_lines = check_output(ja_lines, output)
        except TranslatorFailed as failure:
            # Nothing has been written yet: planned output stays in memory.
            print(f"{name}: {failure}. {NEXT_ACTION}", file=sys.stderr)
            return 1
        if base is not None:
            en_lines = splice(base[0], base[1], ja_lines, en_lines)
        en_meta = {"description": en_lines[0], "cursor": cursor}
        planned.append((out_dir / "body.md", "\n".join(en_lines[1:]) + "\n"))
        planned.append((
            out_dir / "meta.json",
            json.dumps(en_meta, ensure_ascii=False, indent=2) + "\n",
        ))

    if not planned:
        print(f"nothing to translate from rules.ja under {root}; wrote nothing")
        return 0
    for path, data in planned:
        write_atomically(path, data)
    print(f"wrote {len(planned)} files from rules.ja under {root}")
    for path, _data in planned:
        print(path.relative_to(root).as_posix())
    return 0


if __name__ == "__main__":
    sys.exit(main())
