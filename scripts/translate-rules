#!/usr/bin/env python3
"""Generate the edition rules.<to> from rules.<from> (default: ja to en)."""

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

from options import OptionError, language
from rule_source import load_rule, missing_rules
from translator import (
    NEXT_ACTION,
    Pair,
    TranslatorFailed,
    call_translator,
    check_output,
    kept_pairs,
    reset_translation,
    splice,
    write_atomically,
)


def git(root: Path, *args: str) -> str:
    completed = subprocess.run(
        ["git", "-C", str(root), *args], capture_output=True, check=True
    )
    return completed.stdout.decode("utf-8").replace("\r\n", "\n")


def rule_lines(description: str, body_text: str) -> list[str]:
    """The rule as the lines the line contract and the splice work on: the
    description, then the body lines (LF, no trailing newline)."""
    body = body_text.replace("\r\n", "\n")
    return [description] + body.rstrip("\n").split("\n")


def base_pair(root: Path, name: str, source: str, target: str) -> tuple[str, list[str], list[str]] | str:
    """The commit that last changed rules.<to>/<name>/body.md, with the source
    and target lines of the rule at that commit, or the error line.

    Both sides come from the same commit, not the working tree, so line i of
    the target is the translation of line i of the source.
    """
    commit = git(root, "log", "-1", "--format=%H", "--",
                 f"rules.{target}/{name}/body.md").strip()

    def show(rel: str) -> str | None:
        try:
            return git(root, "show", f"{commit}:{rel}")
        except subprocess.CalledProcessError:
            return None

    source_meta, source_body = (show(f"rules.{source}/{name}/meta.json"),
                        show(f"rules.{source}/{name}/body.md"))
    if source_meta is None or source_body is None:
        return (f"{name}: rules.{source}/{name} is not in commit {commit[:12]}. "
                f"delete rules.{target}/{name} to translate it in full, then rerun")
    target_meta, target_body = (show(f"rules.{target}/{name}/meta.json"),
                        show(f"rules.{target}/{name}/body.md"))
    if target_meta is None or target_body is None:
        return (f"{name}: rules.{target}/{name} is incomplete in commit {commit[:12]}. "
                f"delete rules.{target}/{name} to translate it in full, then rerun")
    try:
        source_lines = rule_lines(json.loads(source_meta)["description"], source_body)
        target_lines = rule_lines(json.loads(target_meta)["description"], target_body)
    except (json.JSONDecodeError, KeyError, TypeError):
        return (f"{name}: meta.json in commit {commit[:12]} is not a valid rule. "
                f"delete rules.{target}/{name} to translate it in full, then rerun")
    if len(source_lines) != len(target_lines):
        return (f"{name}: rules.{source}/{name}/body.md has {len(source_lines) - 1} lines and "
                f"rules.{target}/{name}/body.md has {len(target_lines) - 1} at commit {commit[:12]}. "
                f"delete rules.{target}/{name} to translate it in full, then rerun")
    return commit, source_lines, target_lines


def git_error(root: Path, target: str) -> str | None:
    """The error line when git cannot read history under root, else None."""
    try:
        subprocess.run(["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"],
                       capture_output=True, check=True)
    except FileNotFoundError:
        return f"rules.{target}: git was not found. install git, then rerun"
    except subprocess.CalledProcessError:
        return (f"rules.{target}: {root} is not a git repository. "
                "run translate-rules in a git clone of this repository")
    return None


def main(argv: list[str] | None = None) -> int:
    reset_translation()
    parser = argparse.ArgumentParser(
        description="Generate the edition rules.<to> from rules.<from>.",
    )
    parser.add_argument("--translator", default="claude",
                        help="translator command (default: claude)")
    parser.add_argument("--from", dest="source", action="append",
                        help="language to translate from: rules.<from> (default: ja)")
    parser.add_argument("--to", dest="target", action="append",
                        help="language to translate into: rules.<to> (default: en)")
    parser.add_argument("--timeout", type=float, default=120,
                        help="seconds one translator call may take (default: 120)")
    parser.add_argument("names", nargs="*", metavar="name",
                        help="rules to consider (default: every rule)")
    args = parser.parse_args(argv)
    try:
        source = language(args.source, "from", "ja")
        target = language(args.target, "to", "en")
    except OptionError as error:
        print(error, file=sys.stderr)
        return 1
    if source == target:
        print(f"to: --from and --to are both {source}. pass two different languages",
              file=sys.stderr)
        return 1
    pair = Pair(source, target)
    root = Path(__file__).resolve().parent.parent
    translator = shutil.which(args.translator) or args.translator
    rules_dir = root / f"rules.{source}"

    # Phase 1: decide every rule before any translator call, so an error in
    # one rule costs no calls and writes nothing.
    if not rules_dir.is_dir():
        print(missing_rules(source), file=sys.stderr)
        return 1
    available = sorted(p.name for p in rules_dir.iterdir() if p.is_dir())
    errors = [
        f"{name}: no such rule in rules.{source}. "
        f"pass the name of a directory under rules.{source}"
        for name in args.names if name not in available
    ]
    selected = [name for name in available if not args.names or name in args.names]

    # History is read only for rules that already have a target edition.
    if any((root / f"rules.{target}" / name).is_dir() for name in selected):
        problem = git_error(root, target)
        if problem:
            print(problem, file=sys.stderr)
            return 1

    # (name, cursor, current source lines, base pair or None, unchanged,
    #  whether rules.<to>/<name>/meta.json holds a different cursor)
    decided: list[tuple[str, dict, list[str], tuple[list[str], list[str]] | None,
                        bool, bool]] = []
    for name in selected:
        rule = load_rule(rules_dir / name)
        if isinstance(rule, str):
            errors.append(rule)
            continue
        source_lines = rule_lines(rule.description, rule.body.decode("utf-8"))
        cursor = rule.cursor
        if not (root / f"rules.{target}" / name).is_dir():
            decided.append((name, cursor, source_lines, None, False, False))
            continue
        if git(root, "status", "--porcelain", "--", f"rules.{target}/{name}").strip():
            errors.append(
                f"{name}: rules.{target}/{name} has uncommitted changes. "
                f"commit or discard rules.{target}/{name}, then rerun"
            )
            continue
        base = base_pair(root, name, source, target)
        if isinstance(base, str):
            errors.append(base)
            continue
        _commit, previous_source, previous_target = base
        # rules.<to>/<name> is clean here, so the working tree is the base.
        target_meta_text = (root / f"rules.{target}" / name / "meta.json").read_text(encoding="utf-8")
        cursor_stale = json.loads(target_meta_text).get("cursor") != cursor
        decided.append((name, cursor, source_lines, (previous_source, previous_target),
                        previous_source == source_lines, cursor_stale))
    if errors:
        for message in errors:
            print(message, file=sys.stderr)
        return 1

    # Phase 2: translate the targets in memory; write only when all succeed.
    planned: list[tuple[Path, str]] = []
    for name, cursor, source_lines, base, unchanged, cursor_stale in decided:
        out_dir = root / f"rules.{target}" / name
        if unchanged and cursor_stale:
            # The cursor namespace is copied, never translated: no call.
            print(f"copying cursor of {name}", flush=True)
            target_meta = {"description": base[1][0], "cursor": cursor}
            planned.append((
                out_dir / "meta.json",
                json.dumps(target_meta, ensure_ascii=False, indent=2) + "\n",
            ))
            continue
        if unchanged:
            print(f"unchanged {name}", flush=True)
            continue
        print(f"translating {name}", flush=True)
        try:
            reference = kept_pairs(base[0], base[1], source_lines) if base else []
            output = call_translator(translator, source_lines, reference, args.timeout, pair)
            target_lines = check_output(source_lines, output, pair)
        except TranslatorFailed as failure:
            # Nothing has been written yet: planned output stays in memory.
            print(f"{name}: {failure}. {NEXT_ACTION}", file=sys.stderr)
            return 1
        if base is not None:
            target_lines = splice(base[0], base[1], source_lines, target_lines)
        target_meta = {"description": target_lines[0], "cursor": cursor}
        planned.append((out_dir / "body.md", "\n".join(target_lines[1:]) + "\n"))
        planned.append((
            out_dir / "meta.json",
            json.dumps(target_meta, ensure_ascii=False, indent=2) + "\n",
        ))

    if not planned:
        print(f"nothing to translate from rules.{source} under {root}; wrote nothing")
        return 0
    for path, data in planned:
        write_atomically(path, data)
    print(f"wrote {len(planned)} files from rules.{source} under {root}")
    for path, _data in planned:
        print(path.relative_to(root).as_posix())
    return 0


if __name__ == "__main__":
    sys.exit(main())
