#!/usr/bin/env python3
"""Generate Cursor and Claude rules from rules.ja."""

import argparse
import json
import sys
from pathlib import Path


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Generate .cursor/rules and .claude/rules from rules.ja.",
    )
    parser.add_argument(
        "--root",
        required=True,
        help="directory that contains rules.ja",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="compare deliverables and write nothing; name any that are missing or differ",
    )
    args = parser.parse_args(argv)
    root = Path(args.root)
    output_dirs = (".cursor/rules", ".claude/rules")
    missing_dirs: list[str] = []
    if args.check:
        missing_dirs = [rel for rel in output_dirs if not (root / rel).is_dir()]
        if len(missing_dirs) == len(output_dirs):
            print(
                "output directory does not exist. --check writes nothing.",
                file=sys.stderr,
            )
            for rel in missing_dirs:
                print(f"missing: {rel}", file=sys.stderr)
            print("run without --check to write them.", file=sys.stderr)
            return 1
    rules_dir = root / "rules.ja"
    if not rules_dir.is_dir():
        print("rules.ja: missing rules.ja. create rules.ja", file=sys.stderr)
        return 1
    errors: list[str] = []
    planned: list[tuple[Path, bytes]] = []
    for rule_dir in sorted(p for p in rules_dir.iterdir() if p.is_dir()):
        meta_path = rule_dir / "meta.json"
        if not meta_path.is_file():
            errors.append(f"{rule_dir.name}: missing meta.json. create meta.json")
            continue
        try:
            meta = json.loads(meta_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            errors.append(
                f"{rule_dir.name}: invalid JSON in meta.json. fix meta.json"
            )
            continue
        if not isinstance(meta, dict):
            errors.append(
                f"{rule_dir.name}: meta.json is not an object. "
                "replace meta.json with an object"
            )
            continue
        unknown = [key for key in meta if key not in {"description", "cursor"}]
        if unknown:
            key = unknown[0]
            errors.append(
                f'{rule_dir.name}: unknown key "{key}". '
                "remove the unknown key or extend the schema"
            )
            continue
        if "description" not in meta:
            errors.append(
                f"{rule_dir.name}: missing description. add a string description"
            )
            continue
        if not isinstance(meta["description"], str):
            errors.append(
                f"{rule_dir.name}: description is not a string. "
                "set description to a string"
            )
            continue
        if "cursor" not in meta:
            errors.append(f"{rule_dir.name}: missing cursor. add a cursor object")
            continue
        cursor = meta["cursor"]
        if not isinstance(cursor, dict):
            errors.append(
                f"{rule_dir.name}: cursor is not an object. set cursor to an object"
            )
            continue
        cursor_unknown = [key for key in cursor if key not in {"globs", "alwaysApply"}]
        if cursor_unknown:
            key = cursor_unknown[0]
            errors.append(
                f'{rule_dir.name}: unknown key "{key}" in cursor. '
                "remove the unknown key or extend the schema"
            )
            continue
        globs = cursor.get("globs")
        if "globs" in cursor and globs is not None and not isinstance(globs, str):
            errors.append(
                f"{rule_dir.name}: globs is not a string. "
                "set globs to a string or null"
            )
            continue
        if "alwaysApply" in cursor and not isinstance(cursor["alwaysApply"], bool):
            errors.append(
                f"{rule_dir.name}: alwaysApply is not a boolean. "
                "set alwaysApply to true or false"
            )
            continue
        body_path = rule_dir / "body.md"
        if not body_path.is_file():
            errors.append(f"{rule_dir.name}: missing body.md. create body.md")
            continue
        body = body_path.read_bytes()
        lines = ["---", f"description: {meta['description']}"]
        if globs:
            lines.append(f"globs: {globs}")
        if cursor.get("alwaysApply") is not None:
            flag = "true" if cursor["alwaysApply"] else "false"
            lines.append(f"alwaysApply: {flag}")
        lines.append("---")
        rendered = ("\n".join(lines) + "\n\n").encode("utf-8") + body
        claude_body = body
        if globs:
            claude_body = (
                f"---\npaths:\n  - {globs}\n---\n\n".encode("utf-8") + body
            )
        planned.append(
            (root / ".cursor" / "rules" / f"{rule_dir.name}.mdc", rendered)
        )
        planned.append(
            (root / ".claude" / "rules" / f"{rule_dir.name}.md", claude_body)
        )
    if errors:
        for message in errors:
            print(message, file=sys.stderr)
        return 1
    problems: list[str] = []
    empty_dirs: list[str] = []
    if args.check:
        for parent in output_dirs:
            if parent in missing_dirs:
                continue
            # Empty means the directory has no entries. An unrelated file
            # is still a directory the operator can look inside, so the
            # missing deliverables are named one by one.
            if not any((root / parent).iterdir()):
                empty_dirs.append(parent)
    for path, data in planned:
        if args.check:
            rel = path.relative_to(root).as_posix()
            parent = path.parent.relative_to(root).as_posix()
            if parent in missing_dirs or parent in empty_dirs:
                continue
            if not path.is_file():
                problems.append(f"missing: {rel}")
            elif path.read_bytes() != data:
                problems.append(f"differs: {rel}")
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
    if missing_dirs or empty_dirs or problems:
        if missing_dirs and not empty_dirs and not problems:
            summary = "output directory does not exist. --check writes nothing."
        elif empty_dirs and not missing_dirs and not problems:
            summary = "output directory is empty. --check writes nothing."
        else:
            summary = "deliverables do not match rules.ja. --check writes nothing."
        print(summary, file=sys.stderr)
        for rel in missing_dirs:
            print(f"missing: {rel}", file=sys.stderr)
        for rel in empty_dirs:
            print(f"empty: {rel}", file=sys.stderr)
        for line in problems:
            print(line, file=sys.stderr)
        print("run without --check to write them.", file=sys.stderr)
        return 1
    count = len(planned)
    if args.check:
        print(
            f"checked {count} files from rules.ja under {root}; all match; wrote nothing"
        )
    else:
        print(f"wrote {count} files from rules.ja under {root}")
    for path, _data in planned:
        print(path.relative_to(root).as_posix())
    return 0


if __name__ == "__main__":
    sys.exit(main())
