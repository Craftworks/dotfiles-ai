#!/usr/bin/env python3
"""Generate the edition skills.<to> from skills.<from> (default: ja to en).

One translator call is one Markdown file, the same call translate-rules
makes. Several files run at once (--jobs, default 4). Every line of the
file is sent, including a line inside a code fence. basis.md is not
part of the edition. Anything that is not Markdown is copied.
"""

import argparse
import shutil
import subprocess
import sys
import threading
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

from options import OptionError, language
from skill_source import SkillMd, load_skill_md, missing_skills, parse_skill_md
from translator import (
    NEXT_ACTION,
    Pair,
    TranslatorCancelled,
    TranslatorFailed,
    call_translator,
    cancel_translation,
    check_body,
    check_output,
    kept_pairs,
    reset_translation,
    splice,
    write_atomically,
)

PRINT_LOCK = threading.Lock()


def say(line: str) -> None:
    with PRINT_LOCK:
        print(line, flush=True)


def git(root: Path, *args: str) -> str:
    completed = subprocess.run(
        ["git", "-C", str(root), *args], capture_output=True, check=True
    )
    return completed.stdout.decode("utf-8").replace("\r\n", "\n")


def git_error(root: Path, target: str) -> str | None:
    try:
        subprocess.run(
            ["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"],
            capture_output=True, check=True,
        )
    except FileNotFoundError:
        return f"skills.{target}: git was not found. install git, then rerun"
    except subprocess.CalledProcessError:
        return (f"skills.{target}: {root} is not a git repository. "
                "run translate-skills in a git clone of this repository")
    return None


def show(root: Path, commit: str, rel: str) -> str | None:
    try:
        return git(root, "show", f"{commit}:{rel}")
    except subprocess.CalledProcessError:
        return None


def skill_lines(skill: SkillMd) -> list[str]:
    body = skill.body.split("\n") if skill.body else []
    return [skill.description, *body]


def render_skill(skill: SkillMd, description: str, body_lines: list[str]) -> str:
    lines = ["---", f"name: {dict(skill.fields)['name']}", f"description: {description}"]
    for key, value in skill.fields:
        if key not in {"name", "description"}:
            lines.append(f"{key}: {value}")
    lines.append("---")
    text = "\n".join(lines) + "\n"
    if body_lines:
        text += "\n".join(body_lines) + "\n"
    return text


class MarkdownTarget:
    def __init__(self, rel: str, lines: list[str], base, skill: SkillMd | None):
        self.rel = rel
        self.lines = lines
        self.base = base
        self.skill = skill

    def translate(self, translator: str, timeout: float, pair: Pair) -> str:
        """The target file text, or TranslatorFailed.

        The call's JSON shape is a description plus a body. For SKILL.md,
        lines[0] is the description and is checked with check_output. Any
        other Markdown file has no description: it sends "" and is checked
        with check_body, which reads only the body lines of the answer.
        """
        if self.skill:
            request = self.lines
        else:
            request = ["", *self.lines]
        reference = []
        if self.base is not None:
            reference = kept_pairs(self.base[0], self.base[1], self.lines)
        output = call_translator(translator, request, reference, timeout, pair)
        if self.skill:
            new_lines = check_output(request, output, pair)
        else:
            new_lines = check_body(self.lines, output, pair)
        if self.base is not None:
            new_lines = splice(self.base[0], self.base[1], self.lines, new_lines)
        if self.skill:
            return render_skill(self.skill, new_lines[0], new_lines[1:])
        return "\n".join(new_lines) + "\n"


def base_lines(root: Path, skill: str, rel: str, source: str,
               target: str) -> tuple[list[str], list[str]] | str:
    """Source and target lines at the commit that last changed the target
    file, or the error line."""
    commit = git(root, "log", "-1", "--format=%H", "--", f"skills.{target}/{skill}/{rel}").strip()
    if not commit:
        return (f"{skill}/{rel}: skills.{target}/{skill}/{rel} is not committed. "
                f"commit or discard skills.{target}/{skill}/{rel}, then rerun")
    source_text = show(root, commit, f"skills.{source}/{skill}/{rel}")
    target_text = show(root, commit, f"skills.{target}/{skill}/{rel}")
    if source_text is None or target_text is None:
        return (f"{skill}/{rel}: skills.{target}/{skill}/{rel} has no matching pair "
                f"in commit {commit[:12]}. delete skills.{target}/{skill}/{rel} "
                "to translate it in full, then rerun")
    if rel == "SKILL.md":
        source_skill = parse_skill_md(source_text, skill)
        target_skill = parse_skill_md(target_text, skill)
        if isinstance(source_skill, str) or isinstance(target_skill, str):
            return (f"{skill}/SKILL.md: SKILL.md in commit {commit[:12]} is not "
                    f"a valid skill. delete skills.{target}/{skill}/SKILL.md "
                    "to translate it in full, then rerun")
        source_lines, target_lines = skill_lines(source_skill), skill_lines(target_skill)
    else:
        source_lines, target_lines = source_text.splitlines(), target_text.splitlines()
    if len(source_lines) != len(target_lines):
        return (f"{skill}/{rel}: skills.{source} has {len(source_lines)} lines and "
                f"skills.{target} has {len(target_lines)} at commit {commit[:12]}. "
                f"delete skills.{target}/{skill}/{rel} to translate it in full, then rerun")
    return source_lines, target_lines


def main(argv: list[str] | None = None) -> int:
    reset_translation()
    parser = argparse.ArgumentParser(
        description="Generate the edition skills.<to> from skills.<from>.",
    )
    parser.add_argument("--translator", default="claude", help="translator command (default: claude)")
    parser.add_argument("--from", dest="source", action="append",
                        help="language to translate from: skills.<from> (default: ja)")
    parser.add_argument("--to", dest="target", action="append",
                        help="language to translate into: skills.<to> (default: en)")
    parser.add_argument("--timeout", type=float, default=120,
                        help="seconds one translator call may take (default: 120)")
    parser.add_argument("--jobs", type=int, default=4,
                        help="translator calls to run at once (default: 4)")
    parser.add_argument("names", nargs="*", metavar="name",
                        help="skills to consider (default: every skill)")
    args = parser.parse_args(argv)
    try:
        source = language(args.source, "from", "ja")
        target = language(args.target, "to", "en")
    except OptionError as error:
        print(error, file=sys.stderr)
        return 1
    if source == target:
        print(f"to: --from and --to are both {source}. pass two different languages",
              file=sys.stderr)
        return 1
    pair = Pair(source, target)
    if args.jobs < 1:
        print("jobs: --jobs must be at least 1. pass --jobs 4", file=sys.stderr)
        return 1
    root = Path(__file__).resolve().parent.parent
    translator = shutil.which(args.translator) or args.translator
    skills_dir = root / f"skills.{source}"
    if not skills_dir.is_dir():
        print(missing_skills(source), file=sys.stderr)
        return 1
    available = sorted(p.name for p in skills_dir.iterdir() if p.is_dir())
    errors = [
        f"{name}: no such skill in skills.{source}. "
        f"pass the name of a directory under skills.{source}"
        for name in args.names if name not in available
    ]
    selected = [name for name in available if not args.names or name in args.names]
    if any((root / f"skills.{target}" / name).is_dir() for name in selected):
        problem = git_error(root, target)
        if problem:
            print(problem, file=sys.stderr)
            return 1

    targets: list[MarkdownTarget] = []
    copies: list[tuple[str, bytes]] = []
    unchanged: list[str] = []
    for name in selected:
        if (root / f"skills.{target}" / name).is_dir() and git(
            root, "status", "--porcelain", "--", f"skills.{target}/{name}"
        ).strip():
            errors.append(
                f"{name}: skills.{target}/{name} has uncommitted changes. "
                f"commit or discard skills.{target}/{name}, then rerun"
            )
            continue
        loaded = load_skill_md(skills_dir / name)
        if isinstance(loaded, str):
            errors.append(loaded)
            continue
        for path in sorted(p for p in (skills_dir / name).rglob("*") if p.is_file()):
            rel = path.relative_to(skills_dir / name).as_posix()
            if path.name == "basis.md":
                continue
            target_path = root / f"skills.{target}" / name / rel
            if path.suffix != ".md":
                data = path.read_bytes()
                if target_path.is_file() and target_path.read_bytes() == data:
                    unchanged.append(f"{name}/{rel}")
                else:
                    copies.append((f"{name}/{rel}", data))
                continue
            if rel == "SKILL.md":
                lines = skill_lines(loaded)
                current_skill = loaded
            else:
                lines = path.read_text(encoding="utf-8").replace("\r\n", "\n").splitlines()
                current_skill = None
            if not target_path.exists():
                targets.append(MarkdownTarget(f"{name}/{rel}", lines, None, current_skill))
                continue
            base = base_lines(root, name, rel, source, target)
            if isinstance(base, str):
                errors.append(base)
                continue
            previous_source, previous_target = base
            if previous_source == lines:
                unchanged.append(f"{name}/{rel}")
                continue
            targets.append(MarkdownTarget(
                f"{name}/{rel}", lines, (previous_source, previous_target), current_skill
            ))
    if errors:
        for message in errors:
            print(message, file=sys.stderr)
        return 1

    jobs = min(args.jobs, len(targets))
    if targets:
        noun = "file" if len(targets) == 1 else "files"
        say(f"translating {len(targets)} {noun}, {jobs} at a time")
    for rel in unchanged:
        say(f"unchanged {rel}")
    for rel, _data in copies:
        say(f"copying {rel}")
    planned: list[tuple[str, str]] = []
    if targets:
        error: dict[str, str] = {}
        left: list[str] = []
        error_lock = threading.Lock()

        def work(item: MarkdownTarget) -> str | None:
            say(f"translating {item.rel}")
            try:
                return item.translate(translator, args.timeout, pair)
            except TranslatorCancelled:
                return None
            except TranslatorFailed as failure:
                with error_lock:
                    first = "message" not in error
                    if first:
                        error["message"] = f"{item.rel}: {failure}. {NEXT_ACTION}"
                if first:
                    left.extend(cancel_translation())
                return None

        with ThreadPoolExecutor(max_workers=jobs) as pool:
            results = list(pool.map(work, targets))
        if "message" in error:
            print(error["message"], file=sys.stderr)
            for line in left:
                print(line, file=sys.stderr)
            return 1
        for item, text in zip(targets, results):
            planned.append((item.rel, text))

    if not planned and not copies:
        print(f"nothing to translate from skills.{source} under {root}; wrote nothing")
        return 0
    for rel, text in planned:
        write_atomically(root / f"skills.{target}" / rel, text)
    for rel, data in copies:
        path = root / f"skills.{target}" / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
    written = [f"skills.{target}/{rel}" for rel, _text in planned]
    written += [f"skills.{target}/{rel}" for rel, _data in copies]
    written.sort()
    print(f"wrote {len(written)} files from skills.{source} under {root}")
    for path in written:
        print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
